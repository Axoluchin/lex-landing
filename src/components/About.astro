---
import Video from './ui/Video.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Reveal from './ui/Reveal.astro';
import Chip from './ui/Chip.astro';

const values = ['Profesionalismo', 'Solución de problemas', 'Creatividad', 'Capacitación constante', 'Espíritu de servicio'];
---

<section id="nosotros" aria-labelledby="nosotros-titulo" class="bg-paper py-24 md:py-32">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-8 lg:grid-cols-2 lg:gap-20">
    <Reveal effect="left" class="order-2 lg:order-1">
      <Video src="/videos/vid2.mp4" class="aspect-video w-full rounded-lg" />
    </Reveal>

    <div class="order-1 lg:order-2">
      <SectionHeading
        id="nosotros-titulo"
        eyebrow="Presentación"
        title="Una representación jurídica idónea a sus necesidades"
      />
      <Reveal delay={100}>
        <p class="text-lg leading-relaxed text-navy/80">
          <strong class="font-semibold text-navy">Fiscal Lex Soluciones</strong> presenta una propuesta de acompañamiento
          integral diseñada para consolidar la estructura corporativa, mitigar riesgos legales y fortalecer el cumplimiento
          normativo de cualquier grupo empresarial.
        </p>
      </Reveal>
      <Reveal delay={200}>
        <p class="mt-5 leading-relaxed text-navy/75">
          Nuestro enfoque es preventivo, estratégico y alineado a estándares de firmas internacionales, conforme a la
          legislación vigente en México.
        </p>
      </Reveal>
      <Reveal delay={300}>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3" aria-label="Nuestros valores">
          {values.map((value) => <Chip as="li">{value}</Chip>)}
        </ul>
      </Reveal>
    </div>
  </div>
</section>
