---
import { serviceGroups } from '../data/representation';
import Video from './ui/Video.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Reveal from './ui/Reveal.astro';
---

<section id="representacion" aria-labelledby="representacion-titulo" class="bg-cream py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      id="representacion-titulo"
      eyebrow="Representación y corporativo"
      title="Defensa legal y soporte societario de principio a fin"
      intro="De manera enunciativa, estos son algunos de los servicios que forman parte de nuestro catálogo."
    />

    <div class="grid gap-6 lg:grid-cols-[1.5fr_1fr]">
      {
        serviceGroups.map((group, groupIndex) => (
          <Reveal effect={groupIndex === 0 ? 'left' : 'right'} class="flex flex-col gap-6">
            <article
              aria-labelledby={`grupo-${group.id}`}
              class="flex-1 rounded-md border border-ink/10 bg-paper p-7 md:p-10"
            >
              <h3 id={`grupo-${group.id}`} class="font-serif text-2xl font-semibold md:text-3xl">
                {group.title}
              </h3>
              {group.objective && (
                <p class="mt-3 leading-relaxed text-ink/75">
                  <span class="font-semibold text-ink">Objetivo:</span> {group.objective}
                </p>
              )}
              <ul class:list={['mt-6 grid gap-x-8 gap-y-3', group.items.length > 8 && 'md:grid-cols-2']}>
                {group.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink/80">
                    <svg aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-accent-dark" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </article>
            {groupIndex === 1 && (
              <Video src="https://raw.githubusercontent.com/Axoluchin/lex-landing/06ceb22c634cf5ba925cd0d4959252c4ea5cde2d/public/videos/vid3.mp4" class="aspect-video w-full rounded-md" />
            )}
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
