---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  dark?: boolean;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, intro, dark = false, align = 'left' } = Astro.props;
---

<header
  data-reveal="up"
  class:list={['mb-12 max-w-3xl md:mb-16', align === 'center' && 'mx-auto text-center']}
>
  <p
    class:list={[
      'mb-4 text-xs font-semibold tracking-[0.25em] uppercase',
      dark ? 'text-accent' : 'text-accent-dark',
    ]}
  >
    {eyebrow}
  </p>
  <h2
    id={id}
    class:list={[
      'font-serif text-3xl leading-tight font-semibold text-balance md:text-5xl',
      dark ? 'text-cream' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {
    intro && (
      <p class:list={['mt-6 text-base leading-relaxed md:text-lg', dark ? 'text-cream/80' : 'text-ink/75']}>
        {intro}
      </p>
    )
  }
</header>
