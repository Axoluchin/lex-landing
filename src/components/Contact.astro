---
import { fullAddress, maps, show, site } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';
import Reveal from './ui/Reveal.astro';

const channels = [
  { label: 'Teléfono', value: site.phone.display, href: site.phone.href },
  ...(show.email ? [{ label: 'Correo', value: site.email, href: `mailto:${site.email}` }] : []),
  { label: 'WhatsApp', value: 'Iniciar conversación', href: site.whatsapp, external: true },
];
---

<section id="contacto" aria-labelledby="contacto-titulo" class="bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      id="contacto-titulo"
      eyebrow="Contacto"
      title="Hablemos de su empresa"
      intro="Cuéntenos su situación y le orientaremos sobre el siguiente paso. Escríbanos, llámenos o visítenos en nuestra oficina."
    />

    <Reveal effect="scale" class="grid overflow-hidden rounded-md shadow-[0_22px_40px_-18px_rgb(10_10_92/0.35)] lg:grid-cols-2">
        <address class="bg-navy p-8 text-cream not-italic md:p-10">
          <p class="text-xs font-semibold tracking-[0.25em] text-gold uppercase">Oficina</p>
          <p class="mt-2 font-serif text-2xl font-semibold">{site.address.city}</p>
          <p class="text-cream/75">{site.address.state}</p>
          <p class="mt-6 leading-relaxed text-cream/85">{fullAddress}.</p>
          {show.hours && <p class="mt-3 text-sm text-cream/70">{site.hours}</p>}
  
          <ul class="mt-8 space-y-3 border-t border-cream/15 pt-6">
            {
              channels.map((channel) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="text-sm text-cream/70">{channel.label}</span>
                  <a
                    href={channel.href}
                    class="font-medium text-cream underline-offset-4 hover:text-gold hover:underline"
                    {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {channel.value}
                    {channel.external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
                  </a>
                </li>
              ))
            }
          </ul>
          </address>
      <iframe
        src={maps.embed}
        title={`Mapa de la oficina de ${site.name} en ${site.address.city}`}
        class="block min-h-80 w-full bg-sand lg:h-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </Reveal>
  </div>
</section>
