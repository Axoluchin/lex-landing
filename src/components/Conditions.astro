---
import Reveal from './ui/Reveal.astro';

type CommitmentIcon = 'clock' | 'contract' | 'badge';

const commitments: { title: string; description: string; icon: CommitmentIcon }[] = [
  {
    title: 'Respuesta prioritaria',
    description: 'Nos comprometemos a un tiempo de respuesta prioritario en cada asunto que nos confíe.',
    icon: 'clock',
  },
  {
    title: 'Alcance claro',
    description: 'Definimos el alcance de los servicios de forma clara y precisa a través de un contrato.',
    icon: 'contract',
  },
  {
    title: 'Calidad garantizada',
    description: 'Los estándares de calidad más altos durante toda la ejecución del servicio.',
    icon: 'badge',
  },
];

const iconPaths: Record<CommitmentIcon, string> = {
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2M4 4l2.5 2.5M20 4l-2.5 2.5',
  contract: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M8.5 12.5h7M8.5 16h3.5M14 17.5l1.3 1.3 2.7-2.8',
  badge: 'M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM9.5 9l1.8 1.8L14.8 7.3M8.2 13.7 7 21l5-2.5 5 2.5-1.2-7.3',
};
---

<section id="condiciones" aria-labelledby="condiciones-titulo" class="relative overflow-hidden bg-navy py-20 md:py-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 left-1/2 size-[44rem] -translate-1/2 rounded-full bg-[radial-gradient(circle,rgba(212,176,98,0.10)_0%,transparent_65%)]"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <Reveal class="mx-auto max-w-3xl text-center">
      <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-gold uppercase">Condiciones generales</p>
      <h2 id="condiciones-titulo" class="font-serif text-3xl leading-tight font-semibold text-cream text-balance md:text-5xl">
        Un compromiso por escrito con su seguridad jurídica
      </h2>
    </Reveal>

    <ul class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        commitments.map((item, index) => (
          <Reveal as="li" effect="up" delay={index * 140} class="group flex flex-col items-center text-center">
            <span class="relative grid size-20 place-items-center rounded-full bg-gold/10 transition duration-500 group-hover:-translate-y-1 group-hover:bg-gold">
              <span
                aria-hidden="true"
                class="absolute inset-0 rounded-full bg-gold/15 opacity-0 transition duration-500 group-hover:scale-125 group-hover:opacity-100"
              />
              <svg
                aria-hidden="true"
                class="relative size-9 stroke-gold transition-colors duration-500 group-hover:stroke-navy"
                fill="none"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
              >
                <path d={iconPaths[item.icon]} />
              </svg>
            </span>
            <h3 class="mt-6 font-serif text-2xl font-semibold text-cream">{item.title}</h3>
            <span aria-hidden="true" class="mt-4 h-0.5 w-10 bg-gold transition-all duration-500 group-hover:w-20" />
            <p class="mt-4 max-w-xs leading-relaxed text-cream/80">{item.description}</p>
          </Reveal>
        ))
      }
    </ul>

    <Reveal delay={200} class="mt-16 text-center">
      <a
        href="#contacto"
        class="inline-block rounded-md bg-gold px-8 py-3.5 font-semibold text-navy transition-transform duration-300 hover:-translate-y-0.5"
      >
        Solicite su diagnóstico
      </a>
    </Reveal>
  </div>
</section>
